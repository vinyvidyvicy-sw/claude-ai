# Salin ke /etc/portal/portal.env (chmod 640, pemilik root:portal). Jangan simpan rahasia perangkat di sini:
# portal tidak memegang kredensial perangkat.
# TAHAP A (uji HTTP di server saja): PORTAL_COOKIE_SECURE=false
# TAHAP B (lewat nginx HTTPS)      : PORTAL_COOKIE_SECURE=true
PORTAL_COOKIE_SECURE=true
PORTAL_EXECUTION_MODE=dry_run
PORTAL_DB_PATH=/opt/portal/claude-ai/data/portal.db
PORTAL_SESSION_IDLE_MINUTES=15
PORTAL_SESSION_ABSOLUTE_HOURS=8
PORTAL_MAX_FAILED_ATTEMPTS=5
PORTAL_LOCKOUT_MINUTES=15
PORTAL_PASSWORD_MIN_LENGTH=12
# PORTAL_TITLE="Cisco & Splunk Lab Portal"
# PORTAL_AUDIT_JSONL_FILE=/opt/portal/claude-ai/data/audit.jsonl
