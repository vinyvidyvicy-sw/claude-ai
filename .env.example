# Copy to .env or export in your service manager. The portal holds no device credentials.
PORTAL_COOKIE_SECURE=true
PORTAL_SESSION_IDLE_MINUTES=15
PORTAL_SESSION_ABSOLUTE_HOURS=8
PORTAL_MAX_FAILED_ATTEMPTS=5
PORTAL_LOCKOUT_MINUTES=15          # 0 = stay locked until an admin unlocks
PORTAL_PASSWORD_MIN_LENGTH=12
PORTAL_EXECUTION_MODE=dry_run      # dry_run (default) | live
PORTAL_PREVIEW_TTL_MINUTES=30
PORTAL_MAX_CONCURRENT_RUNS=4
# PORTAL_DB_PATH=data/portal.db
# PORTAL_WORKFLOWS_FILE=config/workflows.yaml
# PORTAL_INVENTORY_FILE=config/inventory.yaml
# PORTAL_AUDIT_JSONL_FILE=/var/log/portal/audit.jsonl
PORTAL_BACKEND_POLL_SECONDS=3       # how often to ask the automation backend for status
PORTAL_BACKEND_TIMEOUT_SECONDS=900  # stop waiting after this long (the backend job may continue)
